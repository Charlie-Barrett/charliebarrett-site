---
import '../styles/chrome.css';
interface Props { title: string; description?: string; schema?: object | null; }
const { title, description = '', schema = null } = Astro.props;
---
<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
<meta property="og:title" content={title} />
{description && <meta property="og:description" content={description} />}
<meta property="og:type" content="website" />
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Source+Sans+3:wght@400;600;700&display=swap" rel="stylesheet" />
{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
</head>
<body>
<div class="draftbar">Draft build &middot; not live &middot; Luxury Modules</div>
<header class="site">
  <div class="navwrap">
    <div style="display:flex;align-items:center;gap:14px"><img src="/images/luxury-modules-logo-150px.png" alt="Luxury Modules" style="height:46px;width:auto" onerror="this.style.display='none'" /><div class="logo"><span class="lm">LUXURY MODULES</span><span class="tag">Official UK Partner of Revonia</span></div></div>
    <nav class="main">
      <a href="/">Home</a>
      <a href="/products/">Our Modules</a>
      <a href="/pricing/">Pricing</a>
      <a href="/how-it-works/">How It Works</a>
      <a href="/commercial/">Commercial</a>
      <a href="/book-a-call/">Contact</a>
      <a href="/start-your-project/" class="cta">Start Your Project</a>
    </nav>
    <button class="burger" aria-label="Open menu">&#9776;</button>
  </div>
</header>
<slot />
<footer class="site">
  <div class="foot-grid">
    <div><div class="logo"><span class="lm">LUXURY MODULES</span><span class="tag">Official UK Partner of Revonia</span></div>
      <p style="margin-top:16px;font-size:13.5px;max-width:300px">Turnkey vaulted living spaces, cellars and saunas. 1,500+ projects across Europe. 25-year structural warranty. Planning handled.</p></div>
    <div><b style="color:#fff">Explore</b><br /><br /><a href="/products/">Our Modules</a><br /><a href="/hobbit-houses/">Hobbit Houses</a><br /><a href="/pricing/">Pricing</a><br /><a href="/turnkey/">What's Included</a><br /><a href="/design-yours/">Design Your Module</a><br /><a href="/commercial/">For Commercial</a></div>
    <div><b style="color:#fff">Learn</b><br /><br /><a href="/how-it-works/">How It Works</a><br /><a href="/planning-permission/">Planning Permission</a><br /><a href="/revonia/">The Revonia Partnership</a><br /><a href="/faq/">FAQs</a></div>
    <div><b style="color:#fff">Contact</b><br /><br />Stuart Doust<br /><a href="mailto:sales@luxurymodules.co.uk">sales@luxurymodules.co.uk</a><br /><a href="tel:+447814550508">+44 7814 550 508</a><br /><br /><a href="/start-your-project/">Start Your Project</a></div>
  </div>
  <div class="legal">&copy; 2026 Luxury Modules Ltd. All prices are indicative "from" prices excluding VAT, updated January 2026.</div>
</footer>
<script is:inline>
  if (location.search.indexOf('notes=1') > -1) document.body.classList.add('show-draft-notes');
  var b=document.querySelector('.burger');
  if(b){b.addEventListener('click',function(){var n=document.querySelector('nav.main');n.classList.toggle('open');b.textContent=n.classList.contains('open')?'\u2715':'\u2630';});}
</script>
</body>
</html>
