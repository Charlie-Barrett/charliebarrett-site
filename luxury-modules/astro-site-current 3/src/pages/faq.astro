const schema = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Do garden rooms add value?", "acceptedAnswer": {"@type": "Answer", "text": "Quality permanent garden rooms are generally treated by agents as adding usable space and value \u2014 unlike timber outbuildings, which depreciate. A structure with a 25-year warranty is an asset on a survey, not a chattel."}}, {"@type": "Question", "name": "Are garden rooms worth it?", "acceptedAnswer": {"@type": "Answer", "text": "Against an extension: less disruption, faster, often no planning application, and you keep the garden. Against a cheap cabin: ours cost more and outlast the house. Worth it depends on which comparison you are making \u2014 see the honest comparison on the garden room page."}}, {"@type": "Question", "name": "What do they cost?", "acceptedAnswer": {"@type": "Answer", "text": "From \u00a325,000 for a cellar to \u00a3275,000 for our largest home, turnkey. Range-by-range from-pricing is on the pricing page."}}, {"@type": "Question", "name": "Can you live in a garden room?", "acceptedAnswer": {"@type": "Answer", "text": "Structurally, absolutely \u2014 insulation, heating, kitchens and bathrooms are available throughout the range. Legally, sleeping accommodation needs planning consent as an annexe, which we handle. See the annexe page."}}, {"@type": "Question", "name": "Can you sleep in a garden room?", "acceptedAnswer": {"@type": "Answer", "text": "Occasional guest use is one thing; regular sleeping accommodation makes it ancillary residential use in planning terms. The planning guide covers the line, and we manage consent when you need it."}}, {"@type": "Question", "name": "Is an underground room dark or damp?", "acceptedAnswer": {"@type": "Answer", "text": "Neither. Arched full-height glazing floods them with light, geomembrane waterproofing keeps them dry by design, and ventilation with heat recovery keeps air fresh year-round."}}, {"@type": "Question", "name": "Can I build an underground room in my garden in the UK?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Access for the crane and a site survey are the practical requirements; height rules \u2014 the usual planning constraint \u2014 barely apply to a building with almost no height. The planning guide has the full picture."}}, {"@type": "Question", "name": "How deep do you dig?", "acceptedAnswer": {"@type": "Answer", "text": "Typically the module sits in a shallow excavation with up to 1m of topsoil over it \u2014 this is earth-sheltering, not mining. The site survey confirms levels and drainage before anything is signed."}}, {"@type": "Question", "name": "What ground conditions do you need?", "acceptedAnswer": {"@type": "Answer", "text": "Most gardens are fine. High water tables and difficult access are the things to flag early \u2014 both are usually solvable, and the scoping call is where we tell you honestly."}}, {"@type": "Question", "name": "How long does it all take?", "acceptedAnswer": {"@type": "Answer", "text": "Modules install in hours-to-days. End to end with design and planning, a typical build runs about 26 weeks \u2014 the honest timeline is on how it works."}}, {"@type": "Question", "name": "What does the 25-year warranty cover?", "acceptedAnswer": {"@type": "Answer", "text": "The structural concrete modules and their integrity \u2014 the century-life parts of the building. Fittings carry their manufacturers' warranties. Full detail on the Revonia page."}}, {"@type": "Question", "name": "What maintenance is there?", "acceptedAnswer": {"@type": "Answer", "text": "Concrete does not rot, warp or need retreatment. Maintenance is that of any quality interior, plus keeping drainage clear \u2014 set out in the aftercare pack at handover."}}]};
---
<Layout title="Garden Room & Underground Home FAQs | Luxury Modules" description="Straight answers: do garden rooms add value, can you live in one, how deep do we dig, what about waterproofing. Every question buyers actually ask." schema={schema}>
<div class="pagehero">
  <p class="kicker">Straight Answers</p>
  <h1>Your questions, answered honestly</h1>
  <p>Every question buyers actually ask — value, living in one, the digging, the warranty — answered directly, with links to the detail.</p>
  
  <div style="margin-top:28px"><a class="btn" href="/book-a-call/">Book a Scoping Call</a> <a class="btn ghost" href="#brochure" style="margin-left:8px">Download Brochure</a></div>
</div>
<div class="strip">Official UK Partner of <b>Revonia</b> &nbsp;&middot;&nbsp; <b>1,500+</b> projects across Europe &nbsp;&middot;&nbsp; <b>25-year</b> structural warranty &nbsp;&middot;&nbsp; Planning <b>handled for you</b></div>

<section><div class="wrap">
  <p class="kicker">Value &amp; Investment</p><h2>Money questions</h2><div class="gold-rule"></div>
<div class="faq-item"><h3>Do garden rooms add value?</h3><p>Quality permanent garden rooms are generally treated by agents as adding usable space and value — unlike timber outbuildings, which depreciate. A structure with a 25-year warranty is an asset on a survey, not a chattel.</p></div><div class="faq-item"><h3>Are garden rooms worth it?</h3><p>Against an extension: less disruption, faster, often no planning application, and you keep the garden. Against a cheap cabin: ours cost more and outlast the house. Worth it depends on which comparison you are making — see the honest comparison on the garden room page.</p></div><div class="faq-item"><h3>What do they cost?</h3><p>From £25,000 for a cellar to £275,000 for our largest home, turnkey. Range-by-range from-pricing is on the pricing page.</p></div>
  <p class="kicker" style="margin-top:48px">Living In One</p><h2>Life questions</h2><div class="gold-rule"></div>
<div class="faq-item"><h3>Can you live in a garden room?</h3><p>Structurally, absolutely — insulation, heating, kitchens and bathrooms are available throughout the range. Legally, sleeping accommodation needs planning consent as an annexe, which we handle. See the annexe page.</p></div><div class="faq-item"><h3>Can you sleep in a garden room?</h3><p>Occasional guest use is one thing; regular sleeping accommodation makes it ancillary residential use in planning terms. The planning guide covers the line, and we manage consent when you need it.</p></div><div class="faq-item"><h3>Is an underground room dark or damp?</h3><p>Neither. Arched full-height glazing floods them with light, geomembrane waterproofing keeps them dry by design, and ventilation with heat recovery keeps air fresh year-round.</p></div>
  <p class="kicker" style="margin-top:48px">Building &amp; Ground</p><h2>Build questions</h2><div class="gold-rule"></div>
<div class="faq-item"><h3>Can I build an underground room in my garden in the UK?</h3><p>Yes. Access for the crane and a site survey are the practical requirements; height rules — the usual planning constraint — barely apply to a building with almost no height. The planning guide has the full picture.</p></div><div class="faq-item"><h3>How deep do you dig?</h3><p>Typically the module sits in a shallow excavation with up to 1m of topsoil over it — this is earth-sheltering, not mining. The site survey confirms levels and drainage before anything is signed.</p></div><div class="faq-item"><h3>What ground conditions do you need?</h3><p>Most gardens are fine. High water tables and difficult access are the things to flag early — both are usually solvable, and the scoping call is where we tell you honestly.</p></div><div class="faq-item"><h3>How long does it all take?</h3><p>Modules install in hours-to-days. End to end with design and planning, a typical build runs about 26 weeks — the honest timeline is on how it works.</p></div>
  <p class="kicker" style="margin-top:48px">Warranty &amp; Aftercare</p><h2>Afterwards</h2><div class="gold-rule"></div>
<div class="faq-item"><h3>What does the 25-year warranty cover?</h3><p>The structural concrete modules and their integrity — the century-life parts of the building. Fittings carry their manufacturers' warranties. Full detail on the Revonia page.</p></div><div class="faq-item"><h3>What maintenance is there?</h3><p>Concrete does not rot, warp or need retreatment. Maintenance is that of any quality interior, plus keeping drainage clear — set out in the aftercare pack at handover.</p></div>
  <!-- BUILD NOTE: FAQPage schema markup carried on this page and /planning-permission/ only, per SEO spec. Accordions must be crawlable (no JS-only rendering). -->
</div></section>
