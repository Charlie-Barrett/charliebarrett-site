import '../../styles/components.css';
const schema = {"@context": "https://schema.org", "@type": "Product", "name": "Vaulted Cellars 4.5-21.4m\u00b2", "description": "Naturally cooled underground wine cellars", "brand": {"@type": "Brand", "name": "Revonia"}, "offers": {"@type": "AggregateOffer", "priceCurrency": "GBP", "lowPrice": "25000", "offerCount": 1}, "manufacturer": {"@type": "Organization", "name": "Luxury Modules", "url": "https://luxurymodules.co.uk", "description": "Official UK partner of Revonia. Turnkey vaulted living spaces, cellars and saunas."}};
---
<Layout title="Home Wine Cellars: Vaulted Garden Cellars | Luxury Modules" description="A real vaulted wine cellar in your garden, from 4.5m\u00b2. 1,000-year-old Estonian craft, naturally cooled, installed in days. From-pricing and dimensions." schema={schema}>
<div class="pagehero">
  <p class="kicker">Range 04 · 4.5–21.4m²</p>
  <h1>Vaulted wine cellars, built into your garden</h1>
  <p>A home wine cellar the way it should be built — a real cellar, not a powered cabinet. Naturally cooled vaulted cellars from 4.5m², built on a thousand years of Estonian craft and installed in days.</p>
  <div class="price-anchor">From £25,000</div>
  <div style="margin-top:28px"><a class="btn" href="/book-a-call/">Book a Scoping Call</a> <a class="btn ghost" href="#brochure" style="margin-left:8px">Download Brochure</a></div>
</div>
<div class="strip">Official UK Partner of <b>Revonia</b> &nbsp;&middot;&nbsp; <b>1,500+</b> projects across Europe &nbsp;&middot;&nbsp; <b>25-year</b> structural warranty &nbsp;&middot;&nbsp; Planning <b>handled for you</b></div>
<div class="imgph hero"><img class="real" src="/images/cellar-homepage.jpeg" alt="Home wine cellar interior with vaulted brick ceiling and racked bottles"><span class="lbl">ASSET IN FOLDER → ../Cellar Homepage.jpeg (temp hero — replace with retouched final)</span></div>
<section><div class="wrap">
  <p class="kicker">The Case</p><h2>Why a vaulted cellar</h2><div class="gold-rule"></div>
  <p class="lead">A wine cabinet holds bottles at a temperature. A cellar holds a climate. Under a metre of earth, a vaulted cellar keeps 10–14°C and steady humidity all year with zero energy — the conditions wine has been aged in for a thousand years, in your garden, beautiful enough to entertain in.</p>
  <div class="grid cols3" style="margin-top:36px">
    <div class="card"><div class="body"><h3>Naturally cooled</h3><p>No compressor, no running cost, no hum. The earth does the work, permanently.</p></div></div>
    <div class="card"><div class="body"><h3>Truly stable</h3><p>Temperature swing measured in fractions of a degree across seasons — better than most powered storage.</p></div></div>
    <div class="card"><div class="body"><h3>An occasion</h3><p>Vaulted ceilings, oak and stone. Tastings happen down there, not in the kitchen.</p></div></div>
  </div>
</div></section>

<section class="navy-band"><div class="wrap">
  <p class="kicker">The Range</p><h2>Home wine cellar sizes and configurations</h2><div class="gold-rule"></div>
  <div class="tablewrap"><table class="spec">
    <tr><th>Model</th><th>Size</th><th>Configuration</th><th>From-price</th></tr>
    <tr><td>Cellar 4.5</td><td>4.5m&sup2;</td><td>Single-piece module: walls, vault, floor, doors, roof ducts</td><td>&pound;25,000</td></tr>
    <tr><td>Cellar 11.7</td><td>11.7m&sup2;</td><td>Two interlocking modules: 2m&sup2; entrance + 9.7m&sup2; storage</td><td>&pound;35,000</td></tr>
    <tr><td>Cellar 16.2</td><td>16.2m&sup2;</td><td>Three modules: entrance + 9.7m&sup2; and 4.5m&sup2; storage rooms</td><td>&pound;44,000</td></tr>
    <tr><td>Cellar 21.4</td><td>21.4m&sup2;</td><td>Three vaulted modules: entrance + two 9.7m&sup2; storage rooms</td><td>&pound;52,000</td></tr>
  </table></div>
  <p style="margin-top:18px;font-size:13px;color:#8b95ab">Turnkey from-prices excluding VAT. Every site is different — final pricing follows the scoping call and site assessment.</p>
</div></section>

<section><div class="wrap">
  <p class="kicker">Not Just Wine</p><h2>Wine, whisky or produce</h2><div class="gold-rule"></div>
  <p class="lead">The same natural climate that ages wine suits a whisky collection, a cheese cave or a proper root cellar. Racking, shelving and bench layouts are configured to what you keep — tell us at the scoping call.</p>
  <div class="imgph half"><img class="real" src="/images/wine-cellar-interior.webp" alt="Domed wine cellar interior with full racking and tasting barrel"><span class="lbl">ASSET: wine-cellar-interior.webp — final</span></div>
</div></section>

<section style="background:#efe9db"><div class="wrap">
  <p class="kicker">Fast</p><h2>Installed in days</h2><div class="gold-rule"></div>
  <p class="lead" style="margin-bottom:26px">Precast modules arrive finished; siting, craning and connection take days, not months. Everything is included — see <a href="/turnkey/" style="color:var(--navy);font-weight:600">what turnkey means</a> and <a href="/how-it-works/" style="color:var(--navy);font-weight:600">how it works</a>.</p>
</div></section>
<section style="background:#efe9db"><div class="wrap">
  <p class="kicker">FAQ</p><h2>Your questions, answered</h2><div class="gold-rule"></div>
  <div class="faq-item"><h3>How is this different from a wine cabinet or wine room?</h3><p>A cabinet cools a box with electricity; a vaulted cellar is a naturally cool underground room. No energy use, no mechanical failure risk, far greater capacity, and it adds a genuine room to the property.</p></div><div class="faq-item"><h3>Does a garden cellar need planning permission?</h3><p>Often not — many fall within permitted development. Where consent is needed, we handle the whole application. See our planning guide.</p></div><div class="faq-item"><h3>How long does installation take?</h3><p>Groundworks and installation typically take days. The single-piece Cellar 4.5 is the fastest install in our range.</p></div>
  <p style="margin-top:18px;font-size:14.5px">More questions? <a href="/faq/" style="color:var(--navy);font-weight:600">See the full FAQ</a>.</p>
</div></section><section class="ctaband" id="cta">
  <h2>Start your cellar</h2>
  <p>Book a scoping call to size it for your collection — or take the brochure and browse the range.</p>
  <div class="btns"><a class="btn" href="/book-a-call/">Book a Scoping Call</a><a class="btn ghost" href="#brochure">Download the Brochure</a></div>
  
  <!-- BUILD NOTE: brochure CTA = HubSpot email-only form (hidden fields: product_interest, product_range, audience_type, source_page_url). Scoping CTA -> contact.html until /book-a-call/ with calendar embed exists. -->
</section>
</Layout>
